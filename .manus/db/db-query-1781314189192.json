{
  "query": "\nSELECT \n  t.nome AS tecnico,\n  COUNT(os.id) AS total_os,\n  COUNT(DISTINCT DATE(os.dataConclusao)) AS dias_trabalhados,\n  ROUND(COUNT(os.id) / NULLIF(COUNT(DISTINCT DATE(os.dataConclusao)), 0), 1) AS media_os_por_dia,\n  MIN(DATE(os.dataConclusao)) AS primeiro_dia,\n  MAX(DATE(os.dataConclusao)) AS ultimo_dia\nFROM ordens_servico os\nJOIN tecnicos t ON t.id = os.tecnicoId\nWHERE os.status = 'concluida'\n  AND os.dataConclusao IS NOT NULL\nGROUP BY t.id, t.nome\nORDER BY media_os_por_dia DESC;\n",
