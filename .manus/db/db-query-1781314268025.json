  "query": "\nSELECT \n  DATE(dataConclusao) AS dia,\n  COUNT(*) AS total_os,\n  SUM(COALESCE(qtdApInstalado, 0)) AS total_aps,\n  COUNT(DISTINCT tecnicoId) AS tecnicos_ativos\nFROM ordens_servico\nWHERE status = 'concluida'\n  AND dataConclusao IS NOT NULL\nGROUP BY DATE(dataConclusao)\nORDER BY total_os DESC\nLIMIT 15;\n",
